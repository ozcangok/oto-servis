# Oto Servis Yönetim Sistemi - Ortam Değişkenleri Örneği

PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Veri, yükleme ve yedek dizinleri (Varsayılan: uygulama dizini altındaki ./data, ./uploads, ./backups)
DATA_DIR=./data
BACKUP_DIR=./backups
UPLOAD_DIR=./uploads

# Zaman dilimi
TZ=Europe/Istanbul

# --- AI (Midscene) testleri — opt-in: `npm run test:ai` ---
# Görsel dil modeli anahtarı. Tanımlı DEĞİLSE AI testleri atlanır (ağ/model
# çağrısı yapılmaz). Ayrıntı: e2e-ai/README.md
# Örnek (Alibaba Cloud DashScope Qwen):
# MIDSCENE_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MIDSCENE_MODEL_API_KEY=
# MIDSCENE_MODEL_NAME=qwen3.7-plus
# MIDSCENE_MODEL_FAMILY=qwen3
