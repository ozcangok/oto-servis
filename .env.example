# Oto Servis Yönetim Sistemi - Ortam Değişkenleri Örneği

PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Veri, yükleme ve yedek dizinleri (Varsayılan: uygulama dizini altındaki ./data, ./uploads, ./backups)
DATA_DIR=./data
BACKUP_DIR=./backups
UPLOAD_DIR=./uploads

# Zaman dilimi
TZ=Europe/Istanbul

# E-posta (OTP) gönderimi - NodeMailer SMTP
# Boş bırakılırsa kodlar gönderilmez, sunucu konsoluna yazılır (geliştirme modu)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=ornek@gmail.com
# SMTP_PASS=uygulama-sifresi
# SMTP_FROM=ornek@gmail.com
