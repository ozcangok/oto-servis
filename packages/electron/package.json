{
  "name": "@oto-servis/electron",
  "version": "1.0.0",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests",
    "prepare-app": "node scripts/prepare-app.cjs",
    "dist:dir": "npm run prepare-app && electron-builder --project dist-app --dir",
    "dist:mac": "npm run prepare-app && electron-builder --project dist-app --mac",
    "dist:win": "npm run prepare-app && electron-builder --project dist-app --win nsis"
  },
  "devDependencies": {
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3"
  }
}
